{
  "name": "nyx-dark-mode",
  "version": "1.0.1",
  "private": true,
  "description": "Open-source dark mode for every website. A Safari Web Extension (also runs in Chrome and Firefox) with a Noir-compatible theme and settings model.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "apple:mac": "scripts/apple-build.sh macos",
    "apple:ios": "scripts/apple-build.sh ios",
    "apple:publish": "scripts/apple-publish.sh",
    "chrome:package": "node scripts/chrome-publish.mjs --package-only",
    "chrome:publish": "node scripts/chrome-publish.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
